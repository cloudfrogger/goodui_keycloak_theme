# Copy to .env and replace both passwords before starting compose.hub.yaml.
POSTGRES_PASSWORD=replace-with-a-long-database-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-different-long-admin-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_HOSTNAME=http://localhost:8091
# For reproducible deployments, use the sha-<full-commit> tag from the CI summary.
KEYCLOAK_IMAGE=cloudfrogger/goodui-keycloak-theme:26.8.2
